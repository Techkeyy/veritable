{
  "name": "veritable",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm --filter @veritable/schemas build && pnpm --filter @veritable/policy test && pnpm --filter @veritable/config test && pnpm --filter @veritable/agent test && pnpm --filter @veritable/api test && pnpm --filter @veritable/contracts test && pnpm --filter @veritable/doctor test",
    "test:unit": "pnpm --filter @veritable/schemas build && pnpm --filter @veritable/policy test",
    "test:contracts": "pnpm --filter @veritable/contracts test",
    "typecheck": "pnpm --filter @veritable/schemas build && pnpm --filter @veritable/config build && pnpm --filter @veritable/policy build && pnpm -r typecheck",
    "doctor": "pnpm --filter @veritable/doctor start",
    "preflight:mainnet": "tsx scripts/preflight-mainnet.ts",
    "dev:web": "pnpm --filter @veritable/web dev",
    "dev:api": "pnpm --filter @veritable/api start",
    "dev:agent": "pnpm --filter @veritable/agent start",
    "deploy:testnet": "pnpm --filter @veritable/contracts deploy:testnet",
    "deploy:mainnet": "pnpm --filter @veritable/contracts deploy:mainnet",
    "acceptance:testnet": "pnpm --filter @veritable/contracts acceptance:testnet",
    "init:testnet-env": "tsx scripts/init-testnet-env.ts",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "dotenv": "17.4.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "viem": "2.55.13",
    "vitest": "4.1.10"
  }
}
