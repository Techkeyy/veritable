{
  "name": "@veritable/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm --filter @veritable/schemas build && pnpm --filter @veritable/policy build",
    "build": "next build",
    "build:sites": "vinext build",
    "test:hosted-auth": "node scripts/test-hosted-auth.mjs",
    "acceptance:fresh-production": "node scripts/fresh-wallet-production.mjs",
    "start": "next start",
    "pretypecheck": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@veritable/policy": "workspace:*",
    "@veritable/schemas": "workspace:*",
    "dotenv": "17.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.13",
    "wagmi": "3.7.6"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "@cloudflare/vite-plugin": "1.37.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
