# BOT Chain Testnet is the default development network.
CHAIN_ENV=bot-testnet
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_TESTNET_CHAIN_ID=968

# Added only after the complete testnet acceptance gate passes.
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
BOT_MAINNET_WSS_URL=wss://ws-rpc.botchain.ai
BOT_MAINNET_CHAIN_ID=677
BOT_MAINNET_USDT_ADDRESS=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C

# Mainnet deployment is inert unless this exact confirmation is supplied.
# Use new Mainnet-only identities; never copy Testnet keys.
ALLOW_MAINNET_DEPLOYMENT=
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_VERIFIER_PRIVATE_KEY=
MAINNET_EVIDENCE_SIGNER_PRIVATE_KEY=
MAINNET_EVIDENCE_SIGNER_ADDRESS=
MAINNET_ADMIN_ADDRESS=
MAINNET_GUARDIAN_ADDRESS=
MAINNET_RESOLVER_ADDRESS=
MAINNET_VERIFIER_ADDRESS=
MAINNET_TREASURY_ADDRESS=
MAINNET_VERIFIER_BOND_BOT=
MAINNET_CHALLENGER_BOND_BOT=
MAINNET_CHALLENGE_WINDOW_SECONDS=
MAINNET_UNSTAKE_COOLDOWN_SECONDS=
MAINNET_BLOCKED_REFUND_DELAY_SECONDS=

# Never commit real secrets.
DEPLOYER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
RESOLVER_PRIVATE_KEY=
DATABASE_URL=
AGENT_STATE_PATH=
AGENT_RETRY_INTERVAL_MS=5000
YIELD_VAULT_DEPLOYMENT_BLOCK=
EVIDENCE_SIGNER_PRIVATE_KEY=
EVIDENCE_SIGNER_ADDRESS=
EVIDENCE_INGEST_TOKEN=
EVIDENCE_STORE_PATH=../../.verifi/evidence-bundles.json
MODEL_RUN_HASH=
MODEL_API_KEY=
# Live AI extraction and private evidence storage. Keep values server-side.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
BLOB_READ_WRITE_TOKEN=
WEB_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Testnet deployment role overrides. When blank, the deployer is issuer/holder A
# and the verifier is holder B, giving the demo two distinct revenue recipients.
ISSUER_ADDRESS=
HOLDER_A_ADDRESS=
HOLDER_B_ADDRESS=
TREASURY_ADDRESS=

# Wallet app (BOT Testnet only during Phase 1)
NEXT_PUBLIC_BOT_TESTNET_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_CHAIN_ENV=bot-testnet
NEXT_PUBLIC_ALLOW_MAINNET_WRITES=
NEXT_PUBLIC_BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_CHALLENGER_BOND_BOT=0.25
NEXT_PUBLIC_CHALLENGE_WINDOW_SECONDS=60
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100
NEXT_PUBLIC_ASSET_REGISTRY_ADDRESS=
NEXT_PUBLIC_ASSET_FACTORY_ADDRESS=
NEXT_PUBLIC_YIELD_VAULT_ADDRESS=
NEXT_PUBLIC_ATTESTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_VERIFIER_STAKING_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=
